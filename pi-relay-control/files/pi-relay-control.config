# /etc/config/pi-relay-control
#
# One "config relay" section per relay. Changes take effect after:
#   /etc/init.d/pi-relay-control reload
# (LuCI's "Save & Apply" does this automatically.)

# Uncomment and set gpio_chip if this board's relay header isn't on a
# chip labeled "pinctrl-rp1" or "pinctrl-bcm2835" (Raspberry Pi labels)
# -- the daemon falls back to gpiochip0 otherwise, which is wrong on
# most non-Raspberry-Pi hardware. Accepts either a bare chip number
# ('4') or a full path ('/dev/gpiochip4').
#config globals 'globals'
#	option gpio_chip '0'

config relay
	option gpio_pin	'4'
	option port	'7778'
	option always_on '1'

# Add more sections for additional relays, e.g.:
config relay
	option gpio_pin	'2'
	option port	'7779'
